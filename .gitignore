# --- critical: never commit secrets ---
.env
.env.*
*.key
*.pem

# api keys sometimes leak into local settings
.claude/settings.local.json

# --- runtime / generated, not source ---
.venv/
__pycache__/
*.pyc
*.log
*.output
notes_*.json

# --- downloaded benchmarks (fetched at eval time, not redistributed) ---
data/locomo10.json
data/longmemeval_*.json
data/


# --- stale or transient results ---
results_*.json
# --- stale or transient results ---
results_*.json
!results_nara_*.json
!results_growth_simulation.json

# --- LaTeX build artifacts ---
*.aux
*.bbl
*.blg
*.out
*.toc
*.synctex.gz
# note: main.pdf is intentionally NOT ignored so collaborators can read the build
